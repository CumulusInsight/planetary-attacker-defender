extends "res://tests/prototype11_multicenter_test.gd"
func projectile_math() -> void:
	var actor:=Node2D.new();learning.add_child(actor);actor.position=Vector2(400,400)
	for correct in [true,false]:
		var p=learning.Projectile.new();learning.add_child(p)
		p.setup(actor,Vector2(100,100),0.0,{"contact_id":2,"generation":0,"hit":correct})
		check(p.duration==3.6 and p.effect_duration()==(1.95 if correct else 0.65),"Exact flight and outcome-specific effect duration")
		p.step(1.2);check(not p.impacted_already and p.head.distance_to(p.origin)>0 and p.head.distance_to(actor.global_position)>100,"One-third flight travels, rather than delaying launch")
		actor.position+=Vector2(25,10);p.step(3.599);check(not p.impacted_already,"No early evaluation before 3.6 seconds")
		p.step(3.6);check(p.impacted_already,"Impact/miss evaluated at 3.6 seconds")
		check(p.head.is_equal_approx(actor.global_position) if correct else p.head.distance_to(actor.global_position)>20,"Moving-target correct hit or deterministic miss")
		var impact: Vector2=p.head;actor.position+=Vector2(20,10);p.step(3.9);check(p.head==impact,"Impact center remains fixed as target model moves")
		check(is_equal_approx(p.impact_radius(1),180.0 if correct else 60.0),"Hit arc triples 60 to 180; miss unchanged")
		p.step(3.6+p.effect_duration()-0.001);check(not p.is_queued_for_deletion(),"Effect persists for full configured interval")
		p.step(3.6+p.effect_duration()+0.001);check(p.is_queued_for_deletion(),"Effect completes after exact configured interval")
	actor.queue_free();await frames()
func run() -> void:
	# Inspect direct Report before any analysis.
	learning=load("res://scene/learning_command.tscn").instantiate();learning.session_seed=12345;game=learning;test_viewport.add_child(learning);await frames();command=learning.command;command.set_strategic_pause(true)
	check(learning.nav.keys()==["analyze","report","decide"] and learning.nav.values().map(func(b):return b.text)==["A","R","D"],"Exactly separate A R D in order")
	check(command.decision_pages.top_buttons.keys()==["overview","contacts","threat","intelligence","history","mission","alerts"],"Original P10 controls intact")
	await capture("p11_ar_default")
	await press(learning.nav.report)
	check(learning.page=="report" and not learning.session.analyzed and learning.session.started_at==null and learning.option_buttons.is_empty(),"R never silently analyzes")
	check(learning.report_status.text.contains("Use A"),"Pre-analysis R gives concise instruction")
	await press(learning.nav.analyze);await capture("p11_ar_analyze");await press(learning.no_button)
	check(learning.page.is_empty() and not learning.session.analyzed,"A NO closes without analysis")
	await press(learning.nav.analyze);await press(learning.closes.analyze)
	check(learning.page.is_empty() and not learning.session.analyzed,"A CLOSE does not open Report")
	await press(learning.nav.analyze);await press(learning.yes_button)
	check(learning.page=="report" and learning.session.analyzed,"A YES closes Analyze and opens Report")
	var deadlines: Dictionary=learning.session.learning_deadlines.duplicate(true)
	var official: Dictionary=command.mission.public_snapshot();var ledger: Array=command.operations.session.events()
	learning.close_page();await press(learning.nav.report)
	check(learning.page=="report" and learning.session.round_index==0 and learning.session.learning_deadlines==deadlines,"R opens current Report directly without resetting clocks")
	await capture("p11_ar_direct_report")
	await projectile_math()
	for i in range(learning.loader.questions.size()):
		var q: Dictionary=learning.loader.questions[i];var choice: int=int(q.correct_defense_id) if i<3 else int(q.options.filter(func(d):return int(d)!=int(q.correct_defense_id))[0])
		learning.select_answer(int(q.contact_id),choice)
	learning.close_page();await press(learning.nav.decide);command.set_learning_mode(false);await press(learning.fire_buttons[0]);await create_timer(0.9).timeout
	check(learning.projectiles.size()==5 and learning.orbital_display.centers.size()==3 and learning.session.results.is_empty(),"Five simultaneous three-center flights without early scores")
	var fired: float=learning.projectiles[0].fired_at
	for p in learning.projectiles:check(p.fired_at==fired and p.duration==3.6,"Volley launches simultaneously with slower travel")
	await capture("p11_ar_midflight")
	command.set_learning_mode(true);command.set_strategic_pause(true);await frames()
	var elapsed: float=learning.projectiles[0].elapsed;var head: Vector2=learning.projectiles[0].head
	await create_timer(0.3).timeout
	check(learning.projectiles[0].elapsed==elapsed and learning.projectiles[0].head==head,"Strategic pause freezes flight without catch-up")
	command.set_learning_mode(false);await create_timer(3.45).timeout;await frames()
	check(learning.session.results.size()==5 and learning.session.metrics().correct==3 and learning.session.metrics().incorrect==2,"Independent correct and incorrect evaluations remain exact")
	command.set_learning_mode(true);command.set_strategic_pause(true);await frames()
	var hit_effects: Array=learning.projectiles.filter(func(p):return p.hit)
	check(not hit_effects.is_empty(),"Expanded hit effect remains visible")
	for p in hit_effects:
		check(p.impacted_already and p.effect_duration()==1.95 and p.visual_bounds.has_area(),"Enlarged effect clipped to own center")
		for segment in p.effect_segments(PackedVector2Array([p.visual_bounds.position-Vector2(10,10),p.visual_bounds.end+Vector2(10,10)])):
			for point in segment:check(p.visual_bounds.has_point(point),"Enlarged geometry stays in corresponding center tile")
		check(learning.deadline_text(p.contact_id)=="00:00","Neutralized clock remains zero after impact")
	await capture("p11_ar_expanded_hit")
	elapsed=hit_effects[0].elapsed;head=hit_effects[0].head;await create_timer(0.3).timeout
	check(hit_effects[0].elapsed==elapsed and hit_effects[0].head==head,"Strategic pause freezes explosion age and center")
	learning.reset_view();check(learning.orbital_display.centers.size()==3 and not learning.queued_reset_center.is_empty(),"Manual reset defers until long effects finish")
	command.set_learning_mode(false);await create_timer(2.0).timeout;await frames()
	check(not learning.animations_active() and learning.orbital_display.centers.size()==1,"Deferred reset follows complete 1.95s effect")
	# Reopen the retained multi-center arrangement to inspect and verify lack of any automatic reset.
	learning.orbital_display.layout_centers(["DC-01","DC-02","DC-03"]);learning.view_mode="multi";await create_timer(0.4).timeout;await frames()
	check(learning.orbital_display.centers.size()==3 and learning.reset_view_button.visible,"No automatic reset after all effects; manual button retained")
	await capture("p11_ar_three_retained")
	command.set_learning_mode(true);command.set_strategic_pause(true)
	var answers: Dictionary=learning.session.answers.duplicate(true);var results: Dictionary=learning.session.all_results.duplicate(true)
	await press(learning.nav.report)
	check(learning.session.round_index==0 and learning.loader.questions.size()==5 and learning.session.answers==answers and learning.session.all_results==results,"R reviews completed first round without advancing or clearing")
	await press(learning.nav.analyze);await press(learning.yes_button)
	check(learning.session.round_index==1 and learning.loader.questions.size()==5 and learning.page=="report","Only A YES advances to second five-question round")
	learning.select_report_round(1);await press(learning.closes.report);await press(learning.nav.report)
	check(learning.review_index==0 and learning.option_buttons.values().all(func(options):return options.all(func(b):return b.disabled)),"Direct R preserves historical read-only review")
	check(command.mission.public_snapshot()==official and command.operations.session.events()==ledger,"P10 scoring and canonical operations untouched")
	await close_game()
	print("PROTOTYPE 11 AR PROJECTILE EXPLOSION: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)")
	quit(0 if failures==0 else 1)
