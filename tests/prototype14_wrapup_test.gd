extends "res://tests/prototype4_test.gd"
const CheckList=preload("res://script/p14/watch_checklist.gd")
func run() -> void:
	root.gui_embed_subwindows=false
	game=load("res://scene/odc_entry.tscn").instantiate();test_viewport.add_child(game);await frames(10)
	check(game.watch==null,"Entry does not instantiate live or exercise sessions prematurely")
	await capture("p14_wrapup_desk")
	game.live_game.command.set_strategic_pause(true)
	game.open_watch();await frames(10)
	var w: Control=game.watch;var s: RefCounted=w.session
	check(not s.started and not s.ready_to_finish(),"Unreceived briefing cannot be checked off")
	w.controls.checklist.pressed.emit();await frames()
	check(not s.started and w.panel_mode=="checklist","Checklist is read-only navigation")
	await capture("p14_wrapup_pending")
	w.open_panel("welcome");w.controls.start.pressed.emit();await frames()
	for id in ["mara","imani","eli"]:
		w.open_crew(id);await frames()
		check(w.context_title.text==s.personnel_name(id),"Full rank and full name: "+id)
		check(w.crew_buttons[id].text.contains(s.personnel_name(id)),"Personnel card matches rank: "+id)
	w.open_panel("crew:imani");await capture("p14_wrapup_rank")
	var before: Dictionary={"clock":s.clock,"events":s.events.duplicate(true),"metrics":s.metrics.duplicate(),"met":s.met.duplicate()}
	w.request_return();await frames(10)
	check(game.desk.visible and not w.visible and s.clock==before.clock,"Desk return holds isolated watch clock")
	check(s.events==before.events and s.metrics==before.metrics and s.met==before.met,"Return does not reset outcome or selections")
	if is_instance_valid(game.live_game):game.live_game.command.set_strategic_pause(true)
	game.open_watch();await frames();check(game.watch==w and not s.paused,"Same watch instance resumes")
	w.toggle_pause();game.return_to_desk();await frames();game.open_watch();await frames();check(s.paused,"Explicit pause survives desk round trip");w.toggle_pause()
	check(is_instance_valid(game.live_game) and game.live_game.command.strategic_paused,"Training preserves the existing explicitly paused live mission")
	s.choose_upgrade("identity");s.commission("delegate");s.step(90);check(not s.evidence_reviewed and not s.ready_to_finish(),"Upgrade detection alone is not reviewed evidence");w.open_module("identity");await frames()
	check(s.evidence_reviewed,"Available evidence reviewed through incident UI")
	s.step(101);check(s.unauthorized,"Recoverable delayed-response branch")
	s.rotate_credential();s.step(18)
	check(not s.verify_service() and not s.ready_to_finish(),"Rotation never substitutes for session revocation")
	var rows: Array=CheckList.rows(s)
	check(rows[6].status=="Blocked" and rows[6].reason.contains("Revoke"),"Recovery exposes actual blocker")
	s.revoke_session();s.verify_service();s.step(25)
	check(not s.ready_to_finish() and not s.finish(),"Missing readiness inspection blocks filing despite recovered service")
	w.open_panel("checklist");await frames();await capture("p14_wrapup_blocked")
	w.open_module("core");s.health_check();s.step(17)
	check(not s.ready_to_finish(),"Starting check is not completing check")
	s.step(1);check(s.ready_to_finish(),"Actual health completion unlocks handover")
	w.open_panel("checklist");await frames();await capture("p14_wrapup_ready")
	var verified_rows: Array=CheckList.rows(s)
	check(verified_rows[7].status=="Pending","Report not filed merely because ready")
	w.open_panel("debrief");w.controls.finish.pressed.emit();await frames()
	check(s.finished and CheckList.rows(s)[7].status=="Verified","Filing records actual handover")
	await capture("p14_wrapup_filed")
	for resolution in [Vector2i(1280,720),Vector2i(1600,900),Vector2i(1920,1080)]:
		test_viewport.size=resolution;w.open_panel("checklist");await frames(10)
		check(w.context.get_global_rect().end.x<=resolution.x and w.context.get_global_rect().end.y<=resolution.y,"Checklist fits "+str(resolution))
		for b in w.crew_buttons.values():check(b.get_minimum_size().x<=b.size.x+1,"Crew name wraps within card")
		await capture("p14_wrapup_checklist_%dx%d" % [resolution.x,resolution.y])
	test_viewport.size=Vector2i(1600,900);game.return_to_desk();await frames()
	game.open_orbital();await frames(20)
	check(game.live_game.scene_file_path=="res://scene/prototype13_command.tscn","Persistent host loads existing P13 command scene")
	var live=game.live_game;game.return_to_desk();game.open_orbital();await frames()
	check(game.live_game==live and game.watch==w,"Resuming live command preserves both scene instances")
	game.queue_free();await frames()
	print("PROTOTYPE 14 WRAPUP: ","PASS" if failures==0 else "FAIL"," (",failures," failures / ",checks," checks)")
	quit(0 if failures==0 else 1)
