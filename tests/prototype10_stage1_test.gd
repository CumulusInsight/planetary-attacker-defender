extends "res://tests/prototype4_test.gd"
var command: Node
var ui: CanvasLayer
func settle() -> void: await create_timer(0.24).timeout
func escape() -> void:
	var event:=InputEventKey.new()
	event.keycode=KEY_ESCAPE;event.pressed=true
	test_viewport.push_input(event)
	await frames()
func run() -> void:
	command=load("res://scene/sliding_command.tscn").instantiate()
	game=command
	test_viewport.add_child(command)
	pointer_at(Vector2(800,100))
	await frames()
	ui=command.decision_pages
	command.set_strategic_pause(true)
	await frames()
	check(command.registry.contacts.size()==18 and command.focused_center=="DC-01","Eighteen-contact network starts on original tactical display")
	check(ui.opened.values().all(func(value):return not value),"Default has no large panel")
	check(not command.overview.visible and not command.tactical_centers["DC-01"].get_node("HUD").visible,"Legacy permanent report panels hidden")
	check(not command.mission_ui.local_panel.visible and not command.operations.ui.local_panel.visible,"Legacy mission and operation cards remain hidden after all controller updates")
	for control in ui.top_buttons.values():check(not control.tooltip_text.is_empty(),"Every icon has readable tooltip")
	check(ui.feedback.text.contains("PAUSED"),"Compact status immediately reflects strategic pause")
	await capture("p10_default")
	var tactical=command.tactical_centers["DC-01"]
	var center_before: Transform2D=tactical.global_transform
	var children: Array=tactical.get_node("EnemyContainer").get_children()
	var shapes: Array=children.map(func(c):return c.get_instance_id())
	var remaining: float=tactical.deadline.remaining(tactical.active_contact)
	var official: Dictionary=command.mission.public_snapshot()
	await click_at(ui.top_buttons.contacts.get_global_rect().get_center())
	check(ui.opened.contacts and ui.panels.contacts.position.x<16,"Contacts begins smooth offscreen slide")
	await settle()
	check(ui.panels.contacts.position.is_equal_approx(Vector2(16,112)),"Contacts reaches correct overlay position")
	check(ui.public_rows().size()==18,"All eighteen contacts accessible")
	await capture("p10_contacts")
	for column in range(7):
		ui.contact_table.column_title_clicked.emit(column,MOUSE_BUTTON_LEFT)
		var order: Array=ui.public_rows().map(func(row):return row.contact_id)
		ui.contact_table.column_title_clicked.emit(column,MOUSE_BUTTON_LEFT)
		check(ui.table_sort==column,"All seven accepted sort keys available")
		check(ui.public_rows().size()==18,"Sorting retains all contacts")
	ui.center_filter.select(1);ui.refresh_contacts()
	check(ui.public_rows().size()==6,"Center filter is display-only")
	ui.center_filter.select(0);ui.concern_filter.select(1);ui.refresh_contacts()
	check(ui.public_rows().size()==3,"Deadline filter never invents background deadlines")
	ui.concern_filter.select(0);ui.refresh_contacts()
	ui.contact_table.scroll_to_item(ui.table_rows[18])
	await frames()
	await click_at(ui.contact_table.global_position+ui.contact_table.get_item_area_rect(ui.table_rows[18]).get_center())
	check(ui.selected==18 and command.focused_center=="DC-03","Actual contact-row input navigates to correct center without recreating scene")
	ui.select_contact(11)
	await click_at(ui.top_buttons.threat.get_global_rect().get_center())
	await settle()
	check(ui.opened.threat and not ui.opened.contacts,"Opening right panel closes previous unpinned panel")
	check(ui.selected==11 and command.tactical_centers["DC-01"].selected_attack_id==11,"Contact selection retained")
	check(ui.threat_body.text.contains("Suspected weapon") and ui.threat_body.text.contains("WORM"),"Physical and three cyber suspicions preserved")
	await capture("p10_threat")
	await click_at(ui.pin_buttons.threat.get_global_rect().get_center())
	check(ui.pinned=="threat","Pin retained panel")
	ui.show_drawer("intelligence")
	await settle()
	check(ui.opened.threat and ui.opened.drawer,"Pinned right panel remains with drawer")
	check(not ui.panels.threat.get_global_rect().intersects(ui.panels.drawer.get_global_rect()),"Pinned side and drawer controls cannot overlap")
	check(ui.panels.drawer.size.x==912,"Drawer adapts its own width, not simulation")
	await capture("p10_pinned")
	await escape()
	await settle()
	check(not ui.opened.drawer and ui.opened.threat,"Escape closes active unpinned drawer only")
	ui.open_panel("threat")
	await escape()
	check(ui.opened.threat and ui.pinned=="threat","Escape never closes a pinned active panel")
	await click_at(ui.pin_buttons.threat.get_global_rect().get_center())
	check(ui.pinned.is_empty(),"Unpin works")
	ui.show_drawer("intelligence")
	await settle()
	check(not ui.opened.threat and ui.opened.drawer,"Normal one-large-panel policy restored")
	check(ui.drawer_text.text.contains("Receipt:") and ui.drawer_text.text.contains("-07:00"),"Intelligence preserves real date-time and offset")
	check(ui.drawer_text.text.contains("Simulation receipt"),"Simulation timestamps visible")
	await capture("p10_intelligence")
	ui.drawer_filter.select(1);ui.drawer_filter.item_selected.emit(1)
	check(ui.analysis_filter.selected==1,"Source filter delegates to existing public history")
	ui.show_drawer("history")
	await settle()
	check(ui.drawer_text.text.contains("Intelligence received"),"History retains authoritative report events")
	await capture("p10_history")
	var events: int=command.cyber.journal.size()
	for key in ["contacts","threat","drawer"]:
		ui.open_panel(key);await settle();ui.close_panel(key,true);await settle()
	check(command.cyber.journal.size()==events,"Panel navigation never duplicates events")
	check(tactical.global_transform==center_before and children.map(func(c):return c.get_instance_id())==shapes,"Panel layout does not resize/reparent/recreate simulation objects")
	check(is_equal_approx(tactical.deadline.remaining(tactical.active_contact),remaining),"Navigation never extends paused original deadline")
	check(command.mission.public_snapshot()==official,"Panel use does not change scoring")
	ui.select_contact(10);ui.open_panel("threat");ui.open_responses()
	await settle()
	var options: Array=ui.model.options(77,command.cyber.session.public_view(10).choices.map(func(c):return c.defense_id))
	ui.inspect_defense(options[0])
	check(ui.confirmation.visible and ui.confirmation.get_ok_button().disabled,"Response review cannot bypass escalation")
	await escape()
	check(not ui.confirmation.visible,"Escape cancels confirmation without action")
	var escalate: Dictionary=command.operations.execute(10,"escalate","Public evidence review",command.operations.evidence(10))
	check(escalate.ok,"Existing escalation available")
	ui.inspect_defense(options.filter(func(o):return o.defense_id==138)[0])
	check(not ui.confirmation.get_ok_button().disabled,"Only validated escalated response enables confirmation")
	ui.confirmation.hide()
	ui.confirm_action()
	check(command.operations.session.view(10).state=="RESOLVED","Existing deterministic cyber outcome executed")
	check(command.mission.public_snapshot()==official,"Cyber response still separate from official points")
	ui.select_contact(12);ui.open_panel("contacts");ui.toggle_pin("contacts");ui.open_panel("threat")
	await settle()
	check(not ui.panels.contacts.get_global_rect().intersects(ui.panels.threat.get_global_rect()),"Both side panels fit without interactive overlap")
	ui.toggle_pin("threat")
	check(ui.pinned=="threat" and not ui.opened.contacts,"Only one pin at a time prevents crowded combinations")
	for key in ui.panels:ui.close_panel(key,true)
	await settle()
	await click_at(ui.top_buttons.mission.get_global_rect().get_center())
	check(command.scorecard_open and not ui.shell.visible,"Mission Status opens accepted scorecard without blocking its controls")
	await click_at(command.mission_ui.close_button.get_global_rect().get_center())
	check(not command.scorecard_open and ui.shell.visible,"Mission scorecard returns to orbital interface")
	var hovered: Node=children.filter(func(c):return c.attack_id==11)[0]
	var witness: Node=children.filter(func(c):return c.attack_id==12)[0]
	pointer_at(hovered.global_position)
	await frames(5)
	var held: float=hovered.total_orbit_travel
	var other_travel: float=witness.total_orbit_travel
	await frames(8)
	check(hovered.is_hovered and is_equal_approx(held,hovered.total_orbit_travel),"Actual orbital hover freezes only the contacted glyph with panels closed")
	check(witness.total_orbit_travel>other_travel,"Other spacecraft continue independently during hover")
	await click_at(hovered.global_position)
	check(ui.selected==11,"Orbital click updates selected contact in sliding controls")
	pointer_at(Vector2(800,100));await frames(6)
	check(hovered.total_orbit_travel>held,"Mouse exit resumes the same contact")
	command.set_learning_mode(false)
	var previous: float=tactical.deadline.remaining(tactical.active_contact)
	await frames(12)
	check(tactical.deadline.remaining(tactical.active_contact)<previous,"Challenge continues with panels closed")
	ui.open_panel("threat");await settle()
	previous=tactical.deadline.remaining(tactical.active_contact)
	await frames(12)
	check(tactical.deadline.remaining(tactical.active_contact)<previous,"Challenge continues with a panel open")
	for secret in ["private_attack_id","covert_relay","peaceful_survey_probe","actual_result"]:
		check(not (ui.threat_body.text+ui.drawer_text.text).contains(secret),"No hidden truth in sliding UI")
	await close_game()
	print("PROTOTYPE 10 STAGE 1: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)")
	quit(0 if failures==0 else 1)
