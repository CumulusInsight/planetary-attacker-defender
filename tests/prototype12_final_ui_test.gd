extends "res://tests/prototype12_live_status_test.gd"
func run() -> void:
	learning=load("res://scene/learning_retrofit_command.tscn").instantiate();learning.session_seed=12345;game=learning;test_viewport.add_child(learning);await frames();command=learning.command;command.set_strategic_pause(true);pointer_at(Vector2(40,140))
	var official: Dictionary=command.mission.public_snapshot();var events: Array=command.operations.session.events()
	await press(learning.nav.analyze);await press(learning.yes_button);await frames()
	for i in range(4,8):check(learning.report_headers[i].text.contains("ANSWER OPTION"),"Readable Answer Option headings")
	var q: Dictionary=learning.loader.questions[0];var id: int=q.contact_id;var wrong: int=q.options.filter(func(d):return d!=q.correct_defense_id)[0];var index: int=q.options.find(wrong)
	var answer: Button=learning.option_buttons[id][index]
	await press(answer);check(learning.session.answers[id]==wrong and not learning.detail_panel.visible,"Answer text selects immediately without a lesson")
	var other: int=q.options[(index+1)%4];await press(learning.option_buttons[id][q.options.find(other)].get_node("AnswerCheck"))
	check(learning.session.answers[id]==other and not learning.detail_panel.visible,"Check control changes answer without opening lesson")
	var snapshot: Dictionary=learning.session.answers.duplicate(true);await press(answer.get_node("AnswerInfo"));await frames()
	check(learning.detail_panel.visible and learning.detail_panel.preview_defense==wrong and learning.session.answers==snapshot,"Info opens exact option without selecting/submitting")
	check(learning.detail_panel.body.text.contains(learning.loader.rich_defenses[wrong].definition) and not learning.detail_panel.body.text.contains(learning.loader.rich_attacks[int(q.attack_id)].explanation),"Specific definition without early answer reasoning")
	learning.detail_panel.dismiss();learning.select_answer(id,wrong);await frames();await capture("final_answer_controls")
	check(learning.option_buttons[id].all(func(b):return not b.get_node("CorrectDesignator").visible),"No early green answer-key disclosure")
	await press(learning.submit_answers_button);await frames();learning.show_page("report");await frames()
	answer=learning.option_buttons[id][index]
	var correct_button: Button=learning.option_buttons[id][q.options.find(int(q.correct_defense_id))]
	check(correct_button.get_node("CorrectDesignator").visible and answer.get_node("AnswerCheck").disabled,"Actual correct answer green; original wrong choice locked")
	await press(answer.get_node("AnswerInfo"));await frames()
	check(learning.detail_panel.body.text.contains(learning.loader.rich_attacks[int(q.attack_id)].distractor_reasoning) and learning.detail_panel.body.text.contains(learning.loader.rich_defenses[wrong].limitations),"Post-evaluation scenario contrast and this option's actual limitations")
	await capture("final_wrong_answer_lesson");learning.detail_panel.dismiss();await capture("final_correct_indicator")
	learning.restart_learning();learning.close_page();learning.fire_mode_control.select(1);learning.fire_mode_control.item_selected.emit(1);await frames()
	check(learning.session.firing_mode=="PLAYER FIRE","Player mode selectable at idle boundary")
	learning.show_page("report");choose(3);await press(learning.submit_answers_button);await frames()
	check(learning.projectiles.is_empty() and learning.session.authorized_targets().size()==3 and learning.martian.incoming().is_empty(),"Correct manual answers authorize but create no missile/alarm")
	check(not learning.fire_mode_control.disabled and learning.target_picker.visible,"Mode available during authorization; target picker visible")
	var original_target: int=learning.player_target;learning.target_picker.select(1);learning.target_picker.item_selected.emit(1)
	check(learning.player_target!=original_target and learning.projectiles.is_empty(),"Target picker changes only the selected authorization")
	learning.target_picker.select(0);learning.target_picker.item_selected.emit(0)
	await capture("final_player_authorized")
	var locked: Dictionary=learning.session.pending.duplicate(true);learning.show_page("report");await frames()
	var pending_question: Dictionary=learning.loader.questions[0];await press(learning.option_buttons[int(pending_question.contact_id)][0].get_node("AnswerInfo"));await frames()
	check(learning.detail_panel.visible and not learning.detail_panel.body.text.contains(learning.loader.rich_attacks[int(pending_question.attack_id)].explanation),"Queued answer info works without early evaluation disclosure")
	learning.detail_panel.dismiss();await press(learning.closes.report);check(learning.session.pending==locked,"Queued info and Report CLOSE preserve all authorizations")
	var auth_before: Array=learning.session.authorized_targets().duplicate(true);var times_before: Dictionary=learning.session.learning_deadlines.duplicate(true)
	await press(learning.war_room_button);await frames();await capture("final_war_room")
	check(learning.war_room.visible and learning.war_room.cards.size()==6,"Six-center War Room navigable")
	for card in learning.war_room.cards:check(card.text.contains("UNCONFIRMED") and card.get_line_count()*card.get_theme_font("font").get_height(18)<=card.size.y,"Mockup labels unconfirmed intelligence, fits card")
	check(learning.projectiles.is_empty() and learning.session.authorized_targets()==auth_before,"War Room click never fires or changes authorization")
	await press(learning.war_room.back_button);check(not learning.war_room.visible and learning.session.learning_deadlines==times_before,"Back restores Earth without changing deadlines")
	var first: int=learning.player_target;var center: String=learning.learning_contacts[first].center_id;var point: Vector2=learning.orbital_display.tiles[center].position+Vector2(40,170)
	await click_at(point);await frames()
	check(learning.projectiles.size()==1 and learning.projectiles[0].contact_id==first,"Actual left-click fires exactly the selected authorized target")
	if learning.projectiles.is_empty():await close_game();quit(1);return
	var p=learning.projectiles[0];check(p.duration==36 and learning.session.authorized_targets().size()==2,"36-second flight and single authorization consumption")
	await click_at(point);check(learning.projectiles.size()==1,"Repeated click cannot duplicate or bypass 15-second spacing")
	await sim(10)
	await capture("final_red_trail_reticle")
	var position: Vector2=p.head;var pulse: float=p.trail_pulse();await frames(10)
	check(p.head==position and p.trail_pulse()==pulse,"Strategic pause freezes flight and trail pulse")
	await press(learning.nav.report);await frames();await press(learning.closes.report)
	check(learning.projectiles.size()==1,"Report navigation/UI clicks do not fire next authorization")
	await sim(5);var second: int=learning.player_target;var c2: String=learning.learning_contacts[second].center_id
	await click_at(learning.orbital_display.tiles[c2].position+Vector2(40,170));await frames()
	check(learning.projectiles.size()==2 and learning.session.flights[second].launched_at==learning.session.flights[first].launched_at+15,"Second actual manual launch respects 15 seconds")
	await sim(15);var third: int=learning.player_target;var c3: String=learning.learning_contacts[third].center_id
	await click_at(learning.orbital_display.tiles[c3].position+Vector2(40,170));await frames()
	check(learning.projectiles.size()==3 and learning.session.pending.is_empty(),"Independent manual launches across centers")
	await press(learning.martian.evade_button);check(learning.session.flights.values().all(func(f):return f.evasion_attempted),"Existing independent Martian evasion still available")
	await sim(36);check(not learning.fire_mode_control.disabled,"Mode available through final impact effects")
	await sim(2);check(learning.session.metrics().correct==3 and learning.session.metrics().incorrect==2,"Manual outcomes preserve correctness scoring")
	await capture("final_player_results")
	check(learning.session.set_firing_mode("AUTO-FIRE"),"Idle completed-round mode switch")
	learning.next_round();await frames();choose(5);learning.close_page();learning.request_fire(0);await frames()
	check(learning.projectiles.size()==1 and learning.session.pending.shots.size()==4,"AUTO compatibility after safe mode switch")
	learning.show_page("report");learning.select_report_round(1);await frames()
	var historic: Dictionary=learning.session.round_history[0].questions[0];var saved_results: Dictionary=learning.session.all_results.duplicate(true)
	var historic_buttons: Array=learning.option_buttons[int(historic.contact_id)]
	check(historic_buttons[int(historic.options.find(int(historic.correct_defense_id)))].get_node("CorrectDesignator").visible and historic_buttons.all(func(b):return b.get_node("AnswerCheck").disabled),"Historical green answer key and locked original selection")
	await press(historic_buttons[0].get_node("AnswerInfo"));await frames()
	check(learning.detail_panel.historical and learning.session.all_results==saved_results,"Historical info remains readable and cannot change score")
	learning.detail_panel.dismiss();await capture("final_historical_answers")
	check(command.mission.public_snapshot()==official and command.operations.session.events()==events,"Canonical scoring/operational ledger unchanged")
	await close_game();print("FINAL ENHANCEMENTS UI: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)");quit(0 if failures==0 else 1)
