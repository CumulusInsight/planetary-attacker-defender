extends "res://tests/prototype12_live_status_test.gd"
func run() -> void:
	learning=load("res://scene/learning_retrofit_command.tscn").instantiate();learning.session_seed=12345;game=learning;test_viewport.add_child(learning);await frames();command=learning.command;command.set_strategic_pause(true);pointer_at(Vector2(40,140))
	var official: Dictionary=command.mission.public_snapshot();var events: Array=command.operations.session.events();var canonical: Array=command.registry.contacts.keys()
	await press(learning.nav.analyze);await press(learning.yes_button)
	var q: Dictionary=learning.loader.questions[0];var id: int=q.contact_id;var panel=learning.detail_panel;var lesson: Dictionary=learning.loader.rich_attacks[int(q.attack_id)]
	learning.open_lesson(q);await frames();await capture("partial_attack_lesson")
	check(panel.attack_body.text==panel.section("Definition",lesson.definition)+panel.section("Realistic Example",lesson.example),"Attack definition then distinct example, verbatim")
	check(panel.attack_body.get_global_rect().end.y<=panel.prompt.get_global_rect().position.y,"Attack lesson precedes question")
	check(panel.prompt.text==lesson.question and panel.prompt.get_global_rect().end.y<=panel.choices[0].get_global_rect().position.y,"Question precedes four choices")
	check(not panel.body.text.contains("Topic type") and not panel.body.text.contains("Game visualization"),"Redundant generic sections removed")
	check(panel.section("Definition","test").begins_with("[b][u]Definition[/u][/b]"),"Underline applies only to heading")
	panel.dismiss();await press(learning.submit_answers_button)
	check(learning.page=="report" and not learning.submission_notice.is_empty() and learning.session.results.is_empty(),"Empty submission stays open, does not grade")
	# Hover reads exact editorial text without choosing/grading.
	var control: Button=learning.option_buttons[id][0];learning.show_explanation(control,int(q.options[0]))
	check(control.tooltip_text.contains(learning.loader.rich_defenses[int(q.options[0])].definition) and learning.session.answers.is_empty(),"Catalog-derived defense hover never selects or submits")
	learning.show_attack_explanation(learning.report_grid.get_child(11),int(q.attack_id))
	check(learning.session.answers.is_empty(),"Attack hover never selects an answer")
	learning.select_answer(id,int(q.correct_defense_id));check(not panel.visible,"Selecting an answer does not open details");learning.open_answer_lesson(q,int(q.correct_defense_id));await frames();await capture("partial_defense_lesson")
	var defense: Dictionary=learning.loader.rich_defenses[int(q.correct_defense_id)]
	check(panel.body.text.contains(defense.definition) and panel.body.text.contains(defense.mechanism) and panel.body.text.contains(defense.conditions) and panel.body.text.contains(defense.limitations) and panel.body.text.contains(defense.example),"Chosen defense's own five teaching fields")
	check(panel.body.text.find("How It Works")<panel.body.text.find("When It Applies") and panel.body.text.find("When It Applies")<panel.body.text.find("Limitations") and panel.body.text.find("Limitations")<panel.body.text.find("Realistic Example"),"Defense lesson ordering")
	check(not panel.body.text.contains(lesson.explanation),"No premature answer rationale")
	var report_position: Vector2=learning.report_grid.position;var report_order: Array=learning.report_order.duplicate()
	panel.dismiss();await frames();check(learning.report_grid.position==report_position and learning.report_order==report_order,"Detail Close preserves Report layout/order")
	var selected: Dictionary=learning.session.answers.duplicate(true)
	for b in learning.option_buttons[id]:
		var line: ColorRect=b.get_node("SelectedUnderline")
		check(line.position.y>b.size.y/2 and line.position.y+line.size.y<=b.size.y,"Report underline below centered answer, inside row")
		check(line.visible==b.button_pressed,"Only selected answer underlined")
	await capture("partial_report_underline")
	await press(learning.closes.report);await frames()
	check(learning.page=="" and learning.learning_context and learning.session.answers==selected and learning.session.results.is_empty() and learning.projectiles.is_empty() and learning.session.pending.is_empty(),"CLOSE returns live with unsent choice, no submission")
	await press(learning.nav.report);check(learning.session.answers==selected,"R reopens same selected answers")
	await press(learning.submit_answers_button);await frames()
	check(learning.page=="" and learning.orbital_display.centers.size()==6 and learning.projectiles.size()==1 and learning.session.submitted_questions.size()==1,"One answer submits, closes, six-center live and immediate launch")
	check(learning.session.metrics().correct==0 and learning.session.results.is_empty(),"Correct answer scores only at impact")
	check(not learning.next_round_button.visible and not learning.session.round_complete(),"Partial submission cannot advance round")
	check(not learning.session.submit_answers().ok,"Active sequence rejects duplicate submission")
	await capture("partial_one_live")
	await sim(35.999);check(not learning.session.results.has(id),"Flight remains 36 simulation seconds")
	await sim(0.001);check(learning.session.results[id].projectile_outcome=="HIT" and learning.session.metrics().correct==1,"Correct partial result authoritative at impact")
	var physical_id: String=learning.session.results[id].physical_id
	await sim(2);await press(learning.nav.report);await frames();await capture("partial_reopened_remaining")
	check(learning.option_buttons[id].all(func(b):return b.disabled) and not learning.submit_answers_button.disabled,"Submitted choice locked, later submission available")
	var remaining: Array=learning.loader.questions.filter(func(row):return row.contact_id!=id)
	check(remaining.all(func(row):return learning.option_buttons[int(row.contact_id)].all(func(b):return not b.disabled)),"Four unanswered questions stay selectable")
	var a: Dictionary=remaining[0];var b: Dictionary=remaining[1]
	learning.select_answer(int(a.contact_id),int(a.correct_defense_id));panel.dismiss()
	learning.select_answer(int(b.contact_id),int(b.options.filter(func(d):return d!=b.correct_defense_id)[0]));panel.dismiss()
	await press(learning.submit_answers_button);await frames()
	check(learning.session.results.size()==2 and learning.session.results[int(b.contact_id)].projectile_outcome=="NOT LAUNCHED" and learning.projectiles.size()==1,"Two-question mixed submission; incorrect has no missile")
	check(learning.session.submitted_questions.size()==3 and learning.session.metrics().incorrect==1,"Only this subset locks/grades")
	var queued_copy: Dictionary=learning.session.pending.duplicate(true);await press(learning.nav.report);await press(learning.closes.report)
	check(learning.session.pending==queued_copy,"CLOSE never cancels active queue")
	await sim(36);await sim(2);await press(learning.nav.report)
	for row in remaining.slice(2):learning.select_answer(int(row.contact_id),int(row.correct_defense_id));panel.dismiss()
	await press(learning.submit_answers_button);await frames();var launch_time: float=learning.session.now
	check(learning.projectiles.size()==1 and learning.session.pending.shots.size()==1,"Last two answers retain sorted stagger queue")
	await sim(14.999);check(learning.projectiles.size()==1,"Second missile not launched early")
	await sim(0.001);check(learning.projectiles.size()==2 and learning.session.flights.values().map(func(f):return f.launched_at).max()==launch_time+15,"Exact 15-second launch spacing")
	check(not learning.session.submit_answers().ok,"No repeated grades/launches during sequence")
	await sim(36);check(not learning.next_round_button.visible,"NEXT waits for impact effects")
	await sim(2);check(learning.session.metrics().correct==4 and learning.session.metrics().incorrect==1 and learning.next_round_button.visible,"All five processed across three submissions, NEXT now available")
	check(not learning.session.physical_targets[physical_id].alive,"Learning HIT persists physically")
	await capture("partial_round_results")
	for round_number in range(1,5):
		learning.next_round();await frames();check(learning.loader.questions.size()==(2 if round_number==4 else 5),"5/5/5/5/2 progression")
		check(not learning.session.physical_targets[physical_id].alive,"Earlier physical target not resurrected")
		choose(3 if round_number==2 else learning.loader.questions.size());panel.dismiss();await press(learning.submit_answers_button);await frames()
		while not learning.session.pending.is_empty():await sim(15)
		await sim(36);await sim(2)
	check(learning.session.all_results.size()==22 and learning.session.metrics().correct==19 and learning.session.metrics().incorrect==3,"Cumulative five-round grading retained")
	learning.show_page("report");learning.select_report_round(1);await frames();var original: Dictionary=learning.session.all_results.duplicate(true)
	check(not learning.submit_answers_button.visible and learning.option_buttons.values().all(func(buttons):return buttons.all(func(button):return button.disabled)),"Historical round read only")
	learning.submit_report();check(learning.session.all_results==original and learning.session.pending.is_empty(),"History cannot submit")
	for buttons in learning.option_buttons.values():
		for button in buttons:check(button.get_node("SelectedUnderline").position.y>button.size.y/2,"Historical underline remains below answer text")
	await capture("partial_history")
	learning.enter_review();await frames();var review=learning.review_model
	check(review.questions.size()==3,"Only original incorrect questions reviewed")
	for missed in review.questions:review.evaluate(missed.learning_id,int(missed.correct_defense_id))
	check(learning.session.all_results==original and learning.projectiles.is_empty() and review.performance().corrected==3,"Review stays noncombat and preserves original score/history")
	check(command.mission.public_snapshot()==official and command.operations.session.events()==events and command.registry.contacts.keys()==canonical,"Prototype 10 canonical scoring/ledger/contacts preserved")
	await close_game();await partial_wait_models();print("LEARNING PARTIAL SUBMISSION UI: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)");quit(0 if failures==0 else 1)

func partial_wait_models() -> void:
	var loader=preload("res://script/rich_learning_loader.gd").new();check(loader.load_questions(null).is_empty(),"Partial WAIT model loads canonical content")
	var contacts: Array=[]
	for center in range(1,7):
		for slot in range(1,7):contacts.append({"center_id":"DC-%02d" % center,"contact_id":center*100+slot})
	loader.generate(12345,contacts)
	for delay in [0,60,300,600]:
		var model=preload("res://script/rich_learning_session.gd").new();model.configure(loader);model.analyze(contacts)
		var q: Dictionary=loader.questions[0];var id: int=q.contact_id;model.select_answer(id,int(q.correct_defense_id))
		var result: Dictionary=model.submit_answers(delay)
		check(result.ok and result.scheduled==1 and result.incorrect==0 and model.results.is_empty(),"Partial submission preserves all four D/WAIT timings")
		check(model.pending.contact_id==id and model.countdown()==delay,"Single queued shot has valid compatibility identity/countdown")
		var second: Dictionary=loader.questions[1];model.select_answer(int(second.contact_id),int(second.correct_defense_id));var snapshot: Dictionary=model.pending.duplicate(true)
		check(not model.submit_answers().ok and model.pending==snapshot and model.answers.has(int(second.contact_id)),"Active batch rejects overlap without losing next selections or changing queue")
		model.advance(delay);var shot: Dictionary=model.begin_due();check(model.claim_launch(shot),"Delayed shot launch claimed once")
		model.advance(delay+36);check(not model.finish_shot(id,model.generation).is_empty(),"Delayed shot finishes only at 36 seconds")
		check(model.submit_answers().ok and model.pending.shots.size()==1,"Second subset submits after first resolves")
		check(model.cancel() and not model.submitted_questions.has(second.learning_id) and model.results.size()==1,"WAIT cancellation unlocks only canceled unlaunched answers")
