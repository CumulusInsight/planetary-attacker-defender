extends "res://tests/prototype4_test.gd"
const Model=preload("res://script/visual_command_model.gd")
var command: Node
var ui: CanvasLayer
func settle() -> void:await create_timer(0.23).timeout
func run() -> void:
	model_checks()
	command=load("res://scene/visual_command.tscn").instantiate();game=command;test_viewport.add_child(command)
	pointer_at(Vector2(800,100));await frames()
	ui=command.decision_pages
	command.set_strategic_pause(true);await frames()
	var official: Dictionary=command.mission.public_snapshot()
	var original=command.tactical_centers["DC-01"]
	var transform_before: Transform2D=original.global_transform
	var deadline: float=original.deadline.remaining(original.active_contact)
	await capture("p10s2_default")
	await click_at(ui.top_buttons.overview.get_global_rect().get_center());await settle()
	check(ui.left_mode=="overview" and ui.overview_root.visible and not ui.contact_table.visible,"Overview is graphical metrics, not Contacts duplication")
	check(ui.overview_cards.contacts.text.begins_with("18"),"Network count is actual eighteen")
	await capture("p10s2_overview")
	await click_at(ui.top_buttons.contacts.get_global_rect().get_center());await settle()
	check(ui.contact_table.visible and not ui.overview_root.visible,"Contacts has its own navigation responsibility")
	await capture("p10s2_contacts")
	ui.select_contact(10);ui.show_section("threat");await settle()
	for id in range(10,15):
		var accessible:=[]
		for h in ui.model.view(id).cyber:accessible.append_array(ui.model.mappings[int(h.attack_id)])
		for c in command.cyber.session.public_view(id).choices:check(accessible.has(c.defense_id),"Every accepted scenario countermeasure remains reachable; no arbitrary replacement")
	var public: Dictionary=command.cyber.session.public_view(10)
	check(ui.cyber_metric.bar.value==public.confidence and ui.cyber_metric.bar.visible,"Cyber bar uses existing public initial assessment confidence")
	for i in range(3):
		var h: Dictionary=ui.model.view(10).cyber[i]
		check(ui.hypothesis_metrics[i].bar.visible==(h.likelihood!=null),"Only numeric likelihood gets a bar")
		if h.likelihood!=null:check(ui.hypothesis_metrics[i].bar.value==h.likelihood,"Exact public hypothesis likelihood, not normalized")
	check(ui.model.view(10).cyber.reduce(func(n,h):return n+(0 if h.likelihood==null else h.likelihood),0)>100,"Multiple independent hypotheses coexist")
	check(ui.hypothesis_labels[0].tooltip_text==ui.model.view(10).cyber[0].evidence,"Compact evidence retains full authored source in tooltip")
	await capture("p10s2_threat")
	await click_at(ui.hypothesis_cards[1].get_global_rect().get_center());await frames()
	check(ui.section=="cyber" and ui.selected_hypothesis==1,"Hypothesis selection reveals mapped defenses in same panel")
	var options: Array=ui.mapped_options
	check(options.map(func(o):return o.defense_id)==[111,112,113],"WORM maps to exact v12 defense IDs")
	check(options.map(func(o):return o.name)==["Segmentation","Firewalls","IPS"],"Exact catalog defense names")
	check(ui.mapped_statuses.all(func(s):return s=="Catalog reference only"),"Mapped does not imply executable")
	ui.inspect_defense(options[0]);check(ui.confirmation.get_ok_button().disabled,"Informational execution is disabled")
	ui.confirmation.hide()
	await capture("p10s2_mapped_defenses")
	ui.selected_hypothesis=0;ui._right_signature="";ui.refresh_views()
	check(ui.mapped_statuses.all(func(s):return s=="Requires escalation"),"Validated options require existing escalation")
	var choice: Dictionary=ui.mapped_options.filter(func(o):return o.defense_id==138)[0]
	ui.inspect_defense(choice);check(ui.confirmation.get_ok_button().disabled,"Cannot bypass escalation by review")
	ui.confirmation.hide()
	command.operations.execute(10,"escalate","Existing public evidence",command.operations.evidence(10))
	ui.inspect_defense(choice);check(not ui.confirmation.get_ok_button().disabled,"Validated escalated response uses accepted confirmation")
	check(not command.cyber.session.public_view(10).result.has("outcome"),"Review alone never executes")
	ui.confirmation.hide();ui.confirm_action()
	check(command.cyber.session.public_view(10).result.outcome=="contained","Accepted cyber evaluator unchanged")
	check(command.mission.public_snapshot()==official,"No new official score from cyber UI")
	ui.select_contact(2);ui.show_section("threat")
	check(not ui.cyber_metric.bar.visible and ui.cyber_metric.value.text.contains("Unknown"),"Unknown is neutral, not zero or full risk")
	check(not ui.physical_metric.bar.visible,"Unknown physical confidence has no fabricated bar")
	ui.select_contact(11);ui.show_section("investigate");await settle()
	var count: int=command.cyber.journal.size()
	check(ui.investigation_metric.bar.value==original.intelligence.latest(11).confidence,"Investigation confidence comes from actual latest report")
	check(not ui.investigation_progress.visible,"No progress percentage before a job exists")
	await capture("p10s2_investigate")
	ui.review_investigation();check(not ui.confirmation.get_ok_button().disabled,"Investigation delegates to existing command confirmation")
	ui.confirmation.hide();ui.confirm_action()
	check(command.operations.session.view(11).investigation=="active","Existing scheduler starts investigation")
	command.operations.execute(12,"investigate");command.operations.execute(13,"investigate")
	ui.select_contact(13);ui.show_section("investigate")
	check(ui.investigation_label.text.contains("Queued / position 1"),"Queue position derives from FIFO event order")
	check(not ui.investigation_progress.visible,"Queued job has no fake work progress")
	command.operations.execute(14,"investigate")
	ui.select_contact(14);ui.show_section("investigate")
	check(ui.investigation_label.text.contains("position 2"),"Second queued request has actual FIFO position two")
	ui.select_contact(15);ui.show_section("investigate")
	check(not ui.investigation_command.disabled and ui.investigation_command.text.contains("queue"),"Full active capacity still allows accepted queued requests")
	command.operations.execute(15,"escalate","Public concern only",command.operations.evidence(15))
	ui.show_section("physical")
	check(ui.physical_label.text.contains("Abstract authorization available"),"Accepted non-cyber abstract physical response remains available after escalation")
	ui.select_contact(11);ui.show_section("monitor");await settle()
	var before: Array=command.operations.session.events()
	ui.refresh_views();ui.refresh_views()
	check(command.operations.session.events()==before,"Monitoring view never mutates operational state")
	check(ui.monitor_label.text.contains("Real age:") and ui.monitor_label.text.contains("Receipt:"),"Monitor exposes authentic time and real age")
	await capture("p10s2_monitor")
	ui.show_section("physical");await settle()
	check(ui.physical_label.text.contains("no matching physical evaluator"),"Unsupported physical action honestly unavailable")
	ui.review_physical();check(ui.confirmation.get_ok_button().disabled,"No new physical evaluator")
	ui.confirmation.hide();await capture("p10s2_physical")
	ui.show_drawer("intelligence");await settle()
	check(ui.evidence_records.size()>=2 and ui.evidence_table.visible,"Intelligence defaults to compact report list")
	check(ui.evidence_records[0].cells[2].contains("T"),"Authentic receipt timestamp in report list")
	await capture("p10s2_intelligence")
	ui.evidence_items[ui.evidence_records[0].key].select(0);await frames()
	check(ui.detail_open and ui.detail_text.text.contains("Receipt:"),"Selecting report expands full original contents")
	ui.detail_open=false;ui.refresh_evidence(true)
	ui.show_drawer("history");ui.history_contact.select(1);ui.refresh_evidence(true);await settle()
	check(ui.displayed_timeline.size()==command.cyber.journal.size(),"Network timeline contains all canonical events")
	var times: Array=ui.displayed_timeline.map(func(e):return Model.epoch(e))
	for i in range(1,times.size()):
		if times[i]!=null and times[i-1]!=null:check(times[i]>=times[i-1],"Timeline is chronological by real recorded instant with stable sequence tie-breaks")
	check(ui.evidence_records[0].cells[0].contains("T") and ui.evidence_records[0].cells[1].contains("ago"),"Timeline shows real timestamp and real age, not sequence IDs")
	await capture("p10s2_history")
	ui.history_center.select(1);ui.refresh_evidence(true)
	check(ui.displayed_timeline.all(func(e):return e.center_id=="DC-01"),"History center filtering")
	ui.history_contact.select(0);ui.refresh_evidence(true)
	check(ui.displayed_timeline.all(func(e):return e.contact_id==ui.selected),"History contact filtering")
	ui.history_type.select(1);ui.refresh_evidence(true)
	check(ui.displayed_timeline.all(func(e):return e.kind==ui.history_type.get_item_text(1)),"History event-type filtering")
	ui.history_recent.select(1);ui.refresh_evidence(true)
	check(ui.displayed_timeline.all(func(e):return Model.epoch(e)!=null),"Recent filter requires reliable real time")
	var events: int=command.cyber.journal.size()
	ui.show_section("threat");ui.show_section("monitor");ui.show_drawer("history");await frames()
	check(command.cyber.journal.size()==events,"Navigation never duplicates recommendations or commands")
	await click_at(ui.top_buttons.mission.get_global_rect().get_center());await frames()
	check(command.scorecard_open and command.mission_ui.close_button.text=="Close" and command.mission_ui.close_button.position.y==16,"Scorecard has consistent upper-right Close")
	await capture("p10s2_mission")
	await click_at(command.mission_ui.close_button.get_global_rect().get_center());await frames()
	check(not command.scorecard_open,"Consistent scorecard Close returns safely")
	check(original.global_transform==transform_before and is_equal_approx(original.deadline.remaining(original.active_contact),deadline),"No movement transforms or paused deadlines changed")
	check(command.mission.public_snapshot()==official,"Official scoring unchanged")
	for secret in ["private_attack_id","actual_result","covert_relay","peaceful_survey_probe"]:
		check(not (ui.monitor_label.text+ui.physical_label.text+ui.detail_text.text+ui.result_label.text).contains(secret),"No private truth disclosed")
	ui.select_contact(11);ui.show_section("investigate")
	var progress_before: float=ui.investigation_progress.value
	command.set_learning_mode(false);var now: float=command.operations.session.now;await frames(12)
	check(ui.investigation_progress.visible and ui.investigation_progress.value>progress_before,"Active investigation progress is measured from recorded start and actual remaining time")
	check(command.operations.session.now>now,"Challenge keeps progressing while graphical UI is open")
	await close_game()
	print("PROTOTYPE 10 STAGE 2: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)")
	quit(0 if failures==0 else 1)
func model_checks() -> void:
	check(Model.age({})=="Time unavailable","No invented age for missing time")
	check(Model.age({"wall_unix":1000},1120)=="2 minutes ago","Real age uses real epoch")
	check(Model.age({"local_datetime":"2026-10-25T01:00:00-07:00"},Time.get_unix_time_from_datetime_string("2026-10-25T08:02:00"))=="2 minutes ago","Recorded timezone offset parsed correctly")
	check(Model.age({"wall_unix":2000},1000)=="Clock discrepancy","Future clock not treated as fresh evidence")
	var reports: Array=[{"report_id":"A","source_type":"SIGINT","severity":1},{"report_id":"B","source_type":"Platform Profile","severity":3,"supersedes":"A"}]
	check(Model.trend(reports)=="No comparable revision","No trend inference across unrelated sources")
	reports[1].source_type="SIGINT"
	check(Model.trend(reports)=="Assessed severity increased","Comparable authored supersession can show direction")
