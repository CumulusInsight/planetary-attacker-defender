extends "res://tests/prototype11_test.gd"
func run() -> void:
	learning=load("res://scene/learning_command.tscn").instantiate();learning.legacy_test_fixture=true;game=learning;test_viewport.add_child(learning);await frames()
	command=learning.command;command.set_strategic_pause(true);pointer_at(Vector2(800,100));await frames()
	learning.analyze()
	for delay in [0,60,300,600]:
		var s=Session.new();s.configure(learning.loader);s.advance(20);s.analyze(command.registry.public_rows())
		check(s.metrics().percentage==0 and s.metrics().elapsed==0,"Zero answers/elapsed safe")
		for id in [10,11,12,13,14]:s.select_answer(id,{10:138,11:138,12:19,13:19,14:140}[id])
		check(s.eligible().size()==5 and s.request_fire(14,delay).ok,"All four firing times accept five-target volley")
		check(s.pending.shots.size()==5 and s.pending.due_at==20+delay,"One immutable common due time")
		check(not s.request_fire(14,delay).ok,"No duplicate pending volley")
		s.select_answer(10,111);check(s.pending.shots[0].defense_id==138,"Later selection cannot mutate captured answer")
		s.advance(20+delay)
		var shots: Array=s.begin_volley();check(shots.size()==5 and s.flights.size()==5,"Five independent simultaneous flights")
		check(s.metrics().correct==0 and s.metrics().incorrect==0,"No score at launch/selection")
		for shot in shots:
			check(not s.finish_shot(shot.contact_id,s.generation).is_empty(),"Each impact completes once")
			check(s.finish_shot(shot.contact_id,s.generation).is_empty(),"Duplicate impact never counts")
		var m: Dictionary=s.metrics();check(m.correct==3 and m.incorrect==2 and m.percentage==60,"Mixed 3/2 result is 60 percent")
		check(s.eligible().is_empty() and not s.request_fire(10,0).ok,"Completed contacts cannot fire again")
		s.advance(21+delay);check(s.metrics().elapsed==1+delay,"Elapsed uses authoritative clock")
		s.reset();check(s.metrics()=={"correct":0,"incorrect":0,"percentage":0.0,"elapsed":0.0},"Reset clears all four metrics")
		s.select_answer(10,138);s.request_fire(10,delay);check(s.cancel() and s.begin_volley().is_empty(),"Volley cancel removes all pending shots")
	# Real rendered eight-column Report and catalog hover with no selection/key changes.
	await open_report()
	check(learning.report_grid.columns==9 and learning.report_grid.get_child(3).text=="TIME","Time immediately follows suspected attack")
	check(learning.report_grid.get_global_rect().end.x<1580,"Nine columns fit target viewport")
	for id in [10,11,12,13,14]:check(learning.time_labels[id].text=="05:00" and not learning.operational_deadline(id).applies,"Explicit learning deadline is separate from P10 operational deadline")
	var original_answers: Dictionary=learning.session.answers.duplicate(true)
	pointer_at(learning.option_buttons[10][0].get_global_rect().get_center());await frames()
	check(learning.hover_explanation.visible and learning.hover_explanation.text.begins_with("Antivirus: "),"Hover identifies catalog defense")
	check(learning.hover_explanation.text.contains(command.decision_pages.words(learning.loader.defenses[138].definition,23)),"Actual catalog description shown")
	check(learning.session.answers==original_answers and learning.session.results.is_empty() and not learning.hover_explanation.text.contains("Correct"),"Hover neither selects nor reveals answer key")
	await capture("p11_refined_hover")
	pointer_at(learning.option_buttons[10][1].get_global_rect().get_center());await frames();check(learning.hover_explanation.text.begins_with("Segmentation:"),"Explanation updates between choices")
	pointer_at(Vector2(25,140));await frames();check(not learning.hover_explanation.visible and learning.hover_explanation.text.is_empty(),"Mouse exit clears stable explanation")
	var definition: String=learning.loader.defenses[138].definition;learning.loader.defenses[138].definition=""
	learning.show_explanation(learning.option_buttons[10][0],138);check(learning.hover_explanation.text=="Antivirus: Description unavailable.","Missing description neutral fallback")
	learning.loader.defenses[138].definition=definition;learning.clear_explanation()
	# Explicit test-only supported operational deadline; production data remains unchanged.
	var ops=command.operations.session
	ops._contacts[10].config.operational_deadline_seconds=165.0
	check(ops.execute(10,"escalate","p11-test-deadline","Test public concern",{"assessment":"Uncertain"}).ok,"Fixture uses existing escalation/deadline owner")
	await frames();check(learning.time_labels[10].text=="02:45","Authentic operational deadline formatted minutes/seconds")
	ops.advance(1);await frames();check(learning.time_labels[10].text=="02:44","Report reflects live authoritative remaining time")
	await capture("p11_refined_countdown")
	ops.advance(164);await frames();check(learning.time_labels[10].text=="EXPIRED","Actual operational expiry retained after resolution")
	check(learning.format_deadline(null)=="NO DEADLINE" and learning.format_deadline(0)=="EXPIRED","Missing versus expired explicit")
	learning.restart_learning()
	var official: Dictionary=command.mission.public_snapshot();var operational: Array=ops.events();var cyber: Dictionary=command.cyber.session.public_view(10)
	await open_report()
	for id in [10,11,12,13,14]:await press(learning.option_buttons[id][{10:0,11:0,12:1,13:0,14:0}[id]])
	await capture("p11_refined_report")
	await press(learning.nav.decide);check(learning.fire_question.text=="Fire on 5 selected targets?","Compact Decide names selected volley size")
	await press(learning.fire_buttons[60]);var remaining: float=learning.session.countdown();await frames(8)
	check(learning.session.pending.shots.size()==5 and learning.session.countdown()==remaining,"Strategic pause holds full volley countdown")
	await capture("p11_refined_scheduled")
	await press(learning.cancel_button);check(learning.session.pending.is_empty(),"Existing Cancel cancels complete volley")
	var positions: Dictionary={}
	for id in [10,11,12,13,14]:positions[id]=learning.actor_for(id).position
	command.set_learning_mode(false);await press(learning.fire_buttons[0])
	check(learning.projectiles.size()==5 and learning.session.flights.size()==5,"One rendered Fire Now launches all five projectiles")
	check(learning.session.metrics().correct==0 and learning.session.metrics().incorrect==0,"No rendered score before impact")
	check(learning.orbital_display.centers.size()==2,"Existing five-question fixture uses separate two-center displays")
	await create_timer(0.25).timeout;await capture("p11_refined_volley")
	for projectile in learning.projectiles:
		check(projectile.origin.is_equal_approx(learning.orbital_display.origins[command.registry.contacts[projectile.contact_id].center_id]),"Projectile uses its own data-center origin")
	await create_timer(3.25).timeout;await frames()
	check(learning.session.results.size()==5 and learning.session.metrics().correct==3 and learning.session.metrics().incorrect==2 and learning.session.metrics().percentage==60,"Rendered mixed volley scores each actual impact")
	for id in [10,11,12,13,14]:
		check(learning.actor_for(id).position!=positions[id],"All own-center target models continue moving")
		check(learning.toast_label.text.contains("C-%03d" % id),"All per-contact results persist together")
		check(learning.session.finish_shot(id,learning.session.generation).is_empty(),"Rendered duplicate impact rejected")
	check(not learning.actor_for(10).visible and learning.actor_for(11).visible,"Hit hides learning visual; miss retains target")
	check(learning.orbital_display.markers[13].visible and not learning.orbital_display.markers[14].visible,"Other-center miss persists, hit preview removed")
	check(learning.score_label.text.contains("60%") and learning.score_label.text.contains("Elapsed Time"),"Compact summary displays percentage and labeled time")
	check(learning.toast_label.text.contains("Incorrect; correct: Segmentation") and learning.toast_label.text.contains("Incorrect; correct: Secure Boot"),"Every miss retains its designated answer")
	await capture("p11_refined_mixed")
	await frames(20);check(learning.session.results.size()==5 and learning.session.metrics().percentage==60,"Refresh does not double count")
	check(command.mission.public_snapshot()==official and ops.events()==operational and command.cyber.session.public_view(10)==cyber,"P10 official score/ledger/evaluator unchanged")
	command.set_learning_mode(true);command.set_strategic_pause(true);await frames();var elapsed: float=learning.session.metrics().elapsed;await frames(8)
	check(learning.session.metrics().elapsed==elapsed,"Elapsed learning time respects simulation pause")
	learning.restart_learning();check(learning.session.metrics().correct==0 and learning.session.metrics().incorrect==0 and learning.session.metrics().percentage==0 and learning.session.metrics().elapsed==0,"Rendered reset clears metrics and volley")
	check(learning.session.pending.is_empty() and not learning.session.in_flight() and learning.actor_for(10).visible,"Reset removes volley and restores original visuals")
	await close_game()
	print("PROTOTYPE 11 REFINEMENTS: ","PASS" if failures==0 else "FAIL"," (",failures," failures; ",checks," checks)")
	quit(0 if failures==0 else 1)
